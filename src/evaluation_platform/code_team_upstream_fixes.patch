@@ -11,6 +11,14 @@ from typing import Dict, Any, List
 from runtime_adapters.pytest_fallback import run_pytest_style_tests
 
 
+# pytest names the failing source file only on its location lines, which read
+# `path/to/file.py:LINENO:`; the short summary names the test file instead. The
+# filter below kept neither shape, so every failure reached the router carrying
+# no source path, could not be attributed to the developer who owns the file,
+# and was dropped as unroutable before any repair round could be scheduled.
+_FAILURE_LOCATION = re.compile(r"^[A-Za-z0-9_./\\-]+\.py:\d+:")
+
+
 class PythonRuntime:
     def _can_run_pytest(self) -> bool:
         return shutil.which("pytest") is not None or importlib.util.find_spec("pytest") is not None
@@ -52,7 +60,13 @@ class PythonRuntime:
     def _parse_failures(self, text: str) -> List[Dict[str, str]]:
         buf = []
         for line in text.splitlines():
-            if line.startswith("E   ") or "FAILED" in line or "ERROR at" in line or line.startswith("Traceback"):
+            if (
+                line.startswith("E   ")
+                or "FAILED" in line
+                or "ERROR at" in line
+                or line.startswith("Traceback")
+                or _FAILURE_LOCATION.match(line)
+            ):
                 buf.append(line)
         stack = "\n".join(buf)
         if not stack:
