@startuml 03-durchlauf
!include stil.puml

component "Orchestrierung" as ORCHESTRIERUNG $INFRA

package "Host" {
  component "Lösungsadapter" as ADAPTER $PLATTFORM
}

package "Aufgabenumgebung" {

  package "Ausführungscontainer" {
    component "Lösungstreiber" as TREIBER $PLATTFORM
    component "Codegenerierungs-\nlösung" as LOESUNG $STUDIE
    component "Modellzugriff" as ZUGRIFF $PLATTFORM
    folder "Generierte Lösung" as WORKSPACE
  }

  package "Bewertungscontainer" {
    folder "Referenztests" as TESTS $STUDIE
    component "Bewertungsverfahren" as VERFAHREN $STUDIE
  }
}

cloud "Modellanbieter" as ANBIETER

database "Laufaufzeichnung" as AUFZEICHNUNG $PLATTFORM

' ---- Ausrichtung ----------------------------------------------------------

' ---- Ablauf ---------------------------------------------------------------
ORCHESTRIERUNG -d-> ADAPTER
ADAPTER        -d-> TREIBER : Dateien

TREIBER  -d-> LOESUNG
TREIBER  .d.> ZUGRIFF
LOESUNG  -d-> ZUGRIFF
ZUGRIFF  -l-> ANBIETER

LOESUNG   -d-> WORKSPACE
WORKSPACE -d-> VERFAHREN
TESTS     -r-> VERFAHREN

ORCHESTRIERUNG ..> VERFAHREN

VERFAHREN -d-> AUFZEICHNUNG
ADAPTER   ..> AUFZEICHNUNG

@enduml
