@startuml 04-auswertung
!include stil.puml

package "Laufaufzeichnung" as AUFZEICHNUNG {
  component "Deklarierter Aufbau" as DEKLARIERT $PLATTFORM
  component "Benchmark-Auflösung" as BENCHMARKREF $PLATTFORM
  component "Ausgeführter Aufbau" as AUSGEFUEHRT $PLATTFORM
  folder "Generierte Lösung" as WORKSPACE
  component "Ablaufprotokolle" as PROTOKOLLE $PLATTFORM
  component "Nutzungsdaten" as NUTZUNG $PLATTFORM
  component "Bewertung" as BEWERTUNG $PLATTFORM
}

package "Auswertung" {
  component "Einlesen und\nVereinheitlichung" as EINLESEN $PLATTFORM
  component "Ursachen-\nklassifikation" as URSACHEN $PLATTFORM
  component "Aggregation" as AGGREGATION $PLATTFORM
}

folder "Abbildungen und Tabellen" as ERGEBNIS

DEKLARIERT   -[hidden]r-> BENCHMARKREF
BENCHMARKREF -[hidden]r-> AUSGEFUEHRT
AUSGEFUEHRT  -[hidden]r-> WORKSPACE
DEKLARIERT   -[hidden]d-> PROTOKOLLE
PROTOKOLLE   -[hidden]r-> NUTZUNG
NUTZUNG      -[hidden]r-> BEWERTUNG

' ---- Ablauf ---------------------------------------------------------------
AUFZEICHNUNG -d-> EINLESEN
EINLESEN     -d-> URSACHEN
URSACHEN     -d-> AGGREGATION
AGGREGATION  -d-> ERGEBNIS

'================================================================== Legende ==
'legend bottom
'  |<#E7EFF9> Evaluierungsplattform |
'endlegend

@enduml
