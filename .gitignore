# Submodules
# Do NOT ignore .gitmodules — it must be committed.
# Each submodule has its own .gitignore; this root file does not
# automatically apply rules inside submodule repositories.
# Generated benchmark task packages. HumanEval is not in Harbor's registry,
# so scripts/build_humaneval_tasks.py generates its 164 task packages from the
# digest-pinned data in benchmarks/humaneval/data. Generated, not source:
# regenerate it rather than editing or committing it.
benchmarks/humaneval/tasks/

# SketchEval is not published as a dataset anywhere: it lives inside the CodeS
# repository, and scripts/build_sketcheval_tasks.py generates its 19 task
# packages from the digest-pinned commit in benchmarks/sketcheval/data.
# Generated, not source: regenerate it rather than editing or committing it.
benchmarks/sketcheval/tasks/

# Standalone CodeTeam arms: each run clones the tool, builds a virtual
# environment, and writes generated repositories and graded copies of them.
# The runner and its record are tracked; what a run produces is not.
scripts/codeteam-standalone/runs/
