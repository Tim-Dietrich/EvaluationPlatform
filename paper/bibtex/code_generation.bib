  pages = {1--6},
  doi = {10.1109/CISP-BMEI68103.2025.11259411},
  urldate = {2026-05-24},
  abstract = {Unit testing is fundamental for software reliability, yet manual test construction is inefficient and often results in limited coverage. Existing automated tools struggle with complex structures, while general-purpose large language models (LLMs) lack domain adaptability and fine-grained coverage control. To address this, we propose a domain adaptive finetuning approach based on the DeepSeek-R1-Distill-Qwen-7B (DeepSeek-7B) model. Using a high quality function-test dataset, the model is fine-tuned with structured prompts that encode abstract syntax tree (AST) execution paths, and a Coverage.py-based feedback mechanism iteratively fills uncovered regions to improve controllability. Experiments on seven open-source projects show substantial gains in line coverage, branch coverage, and mutation score, especially in Spark and Django. Compared with the base model, our method achieves over 20\% higher coverage and outperforms Pynguin. Ablation studies confirm the combined effectiveness of structured prompts and coverage feedback, enabling up to 88.6\% line coverage, 83.3\% branch coverage, and a mutation score of 78.9\%.},
  keywords = {Adaptation models,coverage,Data models,Dynamic programming,fine-tuning,Iterative methods,llMs,Python,Software reliability,Sparks,Syntactics,Test pattern generators,Trees (botanical),unit test},
  file = {C:\Users\timdi\Zotero\storage\95PP5WXD\Long et al. - 2025 - A Python Unit Test Generation Method Based on Fine-Tuned Language Models and Coverage.pdf}
}

@article{netturCypressCopilotDevelopment2025,
