@article{takerngsaksiriPyTesterDeepReinforcement2025,
  title = {{{PyTester}}: {{Deep Reinforcement Learning}} for {{Text-to-Testcase Generation}}},
  shorttitle = {{{PyTester}}},
  author = {Takerngsaksiri, Wannita and Charakorn, Rujikorn and Tantithamthavorn, Chakkrit and Li, Yuan-Fang},
  year = 2025,
