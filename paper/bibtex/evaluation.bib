}

@misc{tempestvanschaikEvaluationMetrics,
  title = {Evaluation Metrics},
  author = {TempestVanSchaik},
  urldate = {2026-05-06},
  abstract = {Evaluating the performance of machine learning models is crucial for determining their effectiveness and reliability. To do that, quantitative measurement with reference to ground truth output (also known as evaluation metrics) are needed. However, LLM applications are a recent and fast evolving ML field, where model evaluation is not straightforward and there is no unified approach to measure LLM performance. Several metrics have been proposed in the literature for evaluating the performance of LLMs. It is essential to use the right metrics that are suitable for the problem we are attempting to solve.},
